{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnforge.local/schemas/lab.schema.json",
  "title": "VulnForge Lab Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cve", "target", "app", "versions", "targets", "limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cve": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
    "target": {"type": "string", "minLength": 1},
    "app": {"type": "string", "minLength": 1},
    "network": {"type": "string"},
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerable", "patched"],
      "properties": {
        "vulnerable": {"type": "string", "minLength": 1},
        "patched": {"type": "string", "minLength": 1}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "version", "base_url", "admin_url"],
        "properties": {
          "role": {"enum": ["vulnerable", "patched", "control"]},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "base_url": {"type": "string", "minLength": 1},
          "admin_url": {"type": "string", "minLength": 1}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mem_limit_mb",
        "cpus",
        "pids_limit",
        "max_duration_seconds",
        "max_request_bytes_total"
      ],
      "properties": {
        "mem_limit_mb": {"type": "integer", "minimum": 1},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "pids_limit": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_request_bytes_total": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "created_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
