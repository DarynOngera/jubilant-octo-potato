{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnforge.local/schemas/detection.schema.json",
  "title": "VulnForge Detection Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cve", "result", "rules", "source"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cve": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
    "result": {"enum": ["TRIGGERED", "NOT_TRIGGERED", "INCONCLUSIVE"]},
    "reason": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result", "rules"],
        "properties": {
          "version": {"type": ["string", "null"]},
          "result": {"enum": ["TRIGGERED", "NOT_TRIGGERED", "INCONCLUSIVE"]},
          "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "triggered", "detail"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "triggered": {"type": "boolean"},
        "detail": {"type": "string"},
        "expected": {
          "enum": ["triggered", "not_triggered", "unknown"]
        }
      }
    }
  }
}
